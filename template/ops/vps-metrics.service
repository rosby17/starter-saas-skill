# Collecteur des mesures du serveur (ops/vps-metrics-agent.py). Installation sur le VPS :
#   sudo mkdir -p /usr/local/lib/saas /etc/saas && sudo cp vps-metrics-agent.py /usr/local/lib/saas/
#   /etc/saas/vps-metrics.env : METRICS_TOKEN=<secret>, METRICS_HOST=<passerelle Docker du serveur>, METRICS_PORT=9101
#   sudo cp vps-metrics.service /etc/systemd/system/ && sudo systemctl enable --now vps-metrics
# Puis dans le SaaS : SERVER_METRICS_URL=http://<passerelle>:9101/metrics et SERVER_METRICS_TOKEN=<même secret> (un Force deploy).
[Unit]
Description=VPS metrics collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/saas/vps-metrics.env
ExecStart=/usr/bin/python3 /usr/local/lib/saas/vps-metrics-agent.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/proc /sys /

[Install]
WantedBy=multi-user.target
