# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url                        # Rempli par l'assistant /setup (Supabase local dans Docker)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                       # Public anon key (safe to expose client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key                   # Server-only, bypasses RLS — never expose to the client

# Facultatif : clé qui chiffre les clés saisies dans /admin/keys. Sans elle, elle est dérivée de SUPABASE_SERVICE_ROLE_KEY.
# APP_ENCRYPTION_KEY=generate-a-long-random-string

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME={{APP_NAME}}                                        # Shown in emails and page titles

# Toutes les clés ci-dessous (paiement, Brevo, CRON_SECRET) peuvent AUSSI être collées depuis l'admin :
# /admin/keys (« Clés et intégrations »), sans toucher au serveur ni redéployer.

# --- TaraMoney billing --------------------------------------------------------
TARA_API_KEY=your-tara-api-key                                    # From your TaraMoney dashboard
TARA_BUSINESS_ID=your-tara-business-id                            # From your TaraMoney dashboard
TARA_WEBHOOK_SECRET=generate-a-long-random-string                 # Shared secret embedded in the webhook callback URL — generate your own, never reuse

# --- Tâches planifiées
CRON_SECRET=generate-a-long-random-string                         # Bearer envoyé par le planificateur aux routes /api/cron/*

# --- Brevo (transactional email) ---------------------------------------------
BREVO_API_KEY=your-brevo-api-key                                  # From Brevo > SMTP & API > API Keys
BREVO_SENDER_EMAIL=hello@yoursaas.app                                   # Must be a verified sender in Brevo
BREVO_SENDER_NAME={{APP_NAME}}                                           # Display name used in outgoing emails
DISABLE_LOW_PRIORITY_EMAILS=false                                  # Set true to skip low-priority emails when near your daily quota

# --- Passerelles supplémentaires (facultatives : seule la passerelle choisie dans /admin/payment-providers doit être configurée)
WARAPPAY_API_KEY=your-warappay-api-key                            # Mobile money, carte et PayPal
WARAPPAY_PRODUCT_CODE=your-product-code                            # UN produit à PRIX LIBRE (pricing_type « variable ») pour tous les forfaits
WARAPPAY_WEBHOOK_SECRET=your-warappay-webhook-secret               # Webhook : https://ton-site/api/payment/webhook/warappay
WARAPPAY_CURRENCY=XOF                                              # Devise de ta boutique Warappay (XOF ou XAF), sinon CURRENCY_MISMATCH
BINANCE_PAY_ID=your-binance-pay-id                                 # Binance Pay manuel : validé à la main dans /admin/orders

# --- Crons (Authorization: Bearer $CRON_SECRET) : /api/cron/update-rates et /api/cron/expire-credits, une fois par jour

# --- Pixel Meta (facultatif) : chargé seulement après accord dans le bandeau des cookies
NEXT_PUBLIC_META_PIXEL_ID=
